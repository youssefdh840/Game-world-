rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'youssefdh840@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins Collection: Read for signed-in users (to verify permissions), write only by admin
    match /admins/{adminId} {
      allow read: if isSignedIn() && isValidId(adminId);
      allow write: if isAdmin() && isValidId(adminId);
    }

    // Users Collection: Public reading for profiles and leaderboards; strict owner mutation
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if true;

      // Profile creation: user can only create their own profile; cannot elevate role to admin
      allow create: if isOwner(userId) && isValidId(userId) &&
        incoming().uid == userId &&
        incoming().username is string && incoming().username.size() >= 2 && incoming().username.size() <= 50 &&
        (!('role' in incoming()) || incoming().role != 'admin' || isAdmin());

      // Profile updates: user can update their own profile; uid remains immutable; role escalation forbidden
      allow update: if isValidId(userId) && (
        isAdmin() || (
          isOwner(userId) &&
          incoming().uid == existing().uid &&
          (!('role' in incoming()) || incoming().role == existing().role || isAdmin())
        )
      );

      allow delete: if isAdmin() && isValidId(userId);

      // Subcollection: User's Virtual Passport Stamps
      match /passport/{countryCode} {
        allow read: if isValidId(userId);
        allow create, update: if (isOwner(userId) || isAdmin()) && isValidId(countryCode);
        allow delete: if (isOwner(userId) || isAdmin()) && isValidId(countryCode);
      }
    }

    // Rooms Collection: Permitted for all users (guests, anonymous, and registered) to create and join by 6-digit code
    match /rooms/{roomId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Duels Collection: Permitted for all users (guests, anonymous, and registered)
    match /duels/{duelId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Game Rooms Collection: Permitted for all users (guest players and authenticated users)
    match /gameRooms/{roomId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Matchmaking Queue: Permitted for all users
    match /matchmaking/{ticketId} {
      allow read, write: if true;
    }

    // Friendships Collection: Requesters and receivers have access
    match /friendships/{friendshipId} {
      allow read: if isSignedIn() && isValidId(friendshipId) && (
        resource.data.requesterId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && isValidId(friendshipId) &&
        incoming().requesterId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(friendshipId) && (
        resource.data.requesterId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isSignedIn() && isValidId(friendshipId) && (
        resource.data.requesterId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
    }

    // Reports Collection: Only reporter can create report; only admins can inspect/resolve
    match /reports/{reportId} {
      allow create: if isSignedIn() && isValidId(reportId) &&
        incoming().reporterId == request.auth.uid &&
        incoming().reason is string && incoming().reason.size() <= 200;
      allow read, update, delete: if isAdmin();
    }

    // Questions Catalog: Public read, admin write
    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Countries Catalog: Public read, admin write
    match /countries/{countryCode} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
